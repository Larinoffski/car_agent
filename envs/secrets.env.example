# Template for a secrets file. Copy to envs/secrets/<env>.env and fill in.
# Secrets only: non-secret config lives in envs/<env>.env. All keys and how to get the values: envs/README.md.

# Generate: make artisan CMD="key:generate --show"
APP_KEY=
# Any value; the postgres container is initialised with it on first start.
DB_PASSWORD=
