# ENV=production. No secrets in this file.
APP_ENV=production
APP_NAME=car_agent
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_RUNTIME=fpm
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
