.git
.local
CLAUDE.local.md
.claude
.codex
.agents
.DS_Store
.idea
.vscode
**/*.log

# Dependencies and runtime files, rebuilt inside the image
vendor
node_modules
.phpunit.cache
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing
storage/framework/views/*
!storage/**/.gitignore

# Secrets (keep in sync with .gitignore)
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
.envrc

# Repo tooling and docs, not needed in images
.github
.githooks
docs
envs
compose*.yaml
Makefile
*.md
.editorconfig
.gitattributes
docker/nginx
docker/postgres
openapi
phpunit.xml
phpstan.neon
psalm.xml
scripts
tests
